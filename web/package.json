{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "extension": "rm -rf .extension-build && mkdir -p '.extension-build/Easeus Mail Tracker' && cp extension/* '.extension-build/Easeus Mail Tracker/' && rm -f public/mail-tracker.zip && cd .extension-build && zip -qrX ../public/mail-tracker.zip 'Easeus Mail Tracker' && cd .. && rm -rf .extension-build",
    "pdf-worker": "cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/realtime-js": "^2.117.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
