generator client {
  provider        = "prisma-client-js"
  // A read with its relations (a client with its tags and projects) as one
  // SQL query rather than one per relation — each round trip to the
  // database is ~14ms from the server, so this is most of a page's wait.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DATABASE_URL goes through Supabase's pgbouncer pooler (port 6543,
  // transaction mode) — fine for the app's own runtime queries, but it's
  // what made `prisma db push` hang indefinitely the first time this ran:
  // transaction-mode pooling doesn't reliably support the DDL/introspection
  // Prisma's schema engine needs. directUrl (port 5432, no pgbouncer) is
  // what migrate/db push actually use instead when this is set.
  directUrl = env("DIRECT_URL")
}

// What someone can SEE and DO. Deliberately separate from Team (which part
// of the agency they work in) and JobTitle (what they're called) — those two
// are org structure and change often; this is the permission bar and changes
// almost never.
//
//   admin    — Ashmit, plus Abhishek by email: every team, every task
//   core     — runs one team: every task in THAT team
//   employee — their own work
enum Role {
  admin
  core
  employee
}

// Whether someone is currently on the team — a former employee's work
// history has to stay readable after they leave, so they're marked rather
// than deleted.
enum EmploymentStatus {
  active
  on_leave
  former
}

// A side of the agency: Operations (everything that fulfils client work —
// editing, audio, thumbnails, channel management) and Sales, with more to
// come. This is the unit visibility is scoped to: a core member sees their
// own team's work and nobody else's, and task tags belong to a team so
// Sales never has to scroll past "Colour correction".
model Team {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  sortOrder Int        @default(0)
  members   User[]
  taskTags  TaskTag[]
  jobTitles JobTitle[]
  // who works in it or (for a Lead) runs it: what a Lead sees, where a
  // Member's work goes (lib/scope.ts)
  access    User[]     @relation("UserDepartments")
  // words that put a task here from its title ("edit, reel, thumbnail"),
  // comma separated (lib/department.ts)
  keywords  String     @default("")
  tasks     Task[]
  workTasks WorkTask[]
}

// What a person is called — "Video editor", "Project manager", "Social media
// manager". Purely descriptive: it never grants access (Role does that), so
// admin can add and remove these freely without touching permissions.
// Each belongs to a department, and whoever holds it sits in that
// department; one with no department is a leadership title that spans the
// whole company ("Chief Executive Officer").
model JobTitle {
  id        String    @id @default(uuid())
  name      String    @unique
  sortOrder Int       @default(0)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId    String?
  users     User[]
  // A position is also a role: what someone does (Video editor, Reel
  // curator). A person holds any number, and each role offers its kinds of
  // work when they add a task. jobTitle stays the one shown under a name.
  holders   User[]    @relation("UserRoles")
  kinds     TaskTag[]
  // how this role's tasks move: "video", "design" or "todo" (its kinds of
  // work follow it; lib/workflow.ts)
  workflow  String    @default("todo")
}

// A personal work item — "audio pass for this episode," "record intro VO"
// — real work that isn't itself a step in a client project's editing-queue
// pipeline (Task, below). Much simpler lifecycle than Task on purpose: no
// client-approval stage, no Frame.io/Drive fields, just enough to track
// that it's happening and see it through.
enum WorkTaskStatus {
  todo
  in_progress
  in_review
  done
}

// matches the team's "Editing Queue Status Guide" — see src/lib/workflow.ts
enum TaskStatus {
  queued
  editing
  sent_for_approval
  sent_for_client_approval
  revision_requested
  final_export_ready
  delivered_and_uploaded
}

// What a project actually produced — the long-form cut, each reel, the
// thumbnails, the YT copy — each with the link to the file. These come out
// of the "Content" database nested inside every episode page in Notion.
// Not Tasks: nobody works a queue on these, they're the finished artifacts.
model ProjectAsset {
  id          String  @id @default(uuid())
  project     Project @relation(fields: [projectId], references: [id])
  projectId   String
  name        String
  contentType String // "Reel", "YouTube Long-Form", "Thumbnails", "Misc." …
  link        String?
  sortOrder   Int     @default(0)

  notionPageId String? @unique

  // what kind of work it is — the same tags a task carries (Reel, Trailer…)
  tags TaskTag[]

  @@index([projectId])
}

enum EngagementType {
  subscription
  one_off
}

enum InvoiceStatus {
  draft
  ready
  sent
  paid
  overdue
}

// How a client's invoicing actually gets triggered — the team runs both
// styles side by side, not one uniform cadence for everyone.
enum BillingCadence {
  monthly_date // invoice on a fixed day of every month (e.g. the 30th)
  milestone // invoice every N delivered tasks
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  role         Role      @default(core)
  passwordHash String?
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  // bumped by a heartbeat while a tab is open (see PresenceHeartbeat) —
  // "active" in the team panel just means "seen in the last few minutes",
  // not a real online/offline socket connection
  lastSeenAt   DateTime?

  // --- org placement: who they work with, what they're called ---
  team        Team?      @relation(fields: [teamId], references: [id])
  teamId      String?
  jobTitle    JobTitle?  @relation(fields: [jobTitleId], references: [id])
  jobTitleId  String?
  // Level is `role` above: admin = Founder, core = Lead, employee = Member.
  // A Lead sees the work in these departments; a Member works in them.
  departments Team[]     @relation("UserDepartments")
  // what they do, each offering its kinds of work (JobTitle)
  roles       JobTitle[] @relation("UserRoles")

  // --- the people record itself, admin-only to edit ---
  phone        String?
  joinedAt     DateTime?
  // Their Notion account, so a task pushed up lands with the right person in
  // the Editing Queue's "Editor" column. Harvested from rows Notion already
  // has; null for anyone who's never appeared on one.
  notionUserId String?

  // A core member's own Notion workbook database. Their work tasks go here
  // rather than into the shared Editing Queue — these are simple to-do lists
  // (a name, a done checkbox, a start date), not the video pipeline. Editors
  // have no workbook of their own: theirs are filtered views of the Editing
  // Queue, so their work still belongs there.
  notionWorkbookDbId String?
  // monthly, in INR. Decimal not Float: money that rounds wrong is worse
  // than money that's slightly awkward to read back out.
  salary             Decimal?         @db.Decimal(12, 2)
  employment         EmploymentStatus @default(active)
  // full_time | part_time | freelance | intern (see team/actions.ts)
  employmentType     String?
  // how they're paid, for Finance: fixed | per_video | hourly, and how
  // often: monthly | fortnightly | weekly
  payStructure       String?
  payCycle           String?
  birthday           DateTime?
  // a name and a number, as one line: "Riya (sister) · +91 98…"
  emergencyContact   String?
  notes              String?          @db.Text

  tasksAssigned     Task[]             @relation("AssignedTasks")
  tasksReviewed     Task[]             @relation("ReviewedTasks")
  workTasksCreated  WorkTask[]         @relation("WorkTasksCreated")
  workTasksAssigned WorkTask[]         @relation("WorkTasksAssigned")
  feedback          Feedback[]
  kpiSnapshots      KpiSnapshot[]
  activity          ActivityLog[]
  clientInvites     ClientInvite[]
  messagesSent      Message[]          @relation("MessagesSent")
  messagesReceived  Message[]          @relation("MessagesReceived")
  performance       PerformanceEntry[] @relation("PerformanceAbout")
  performanceLogged PerformanceEntry[] @relation("PerformanceLogged")
  salaryPayments    SalaryPayment[]
  // the clients an editor (role employee) has been given: the only ones
  // they see, and only their own work on each
  visibleClients    Client[]           @relation("ClientEditors")
}

// Plain 1:1 direct messages between team members — no group threads, no
// separate Conversation row; a thread is just every Message between two
// user ids, queried both directions and sorted by time.
model Message {
  id        String    @id @default(uuid())
  from      User      @relation("MessagesSent", fields: [fromId], references: [id])
  fromId    String
  to        User      @relation("MessagesReceived", fields: [toId], references: [id])
  toId      String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([fromId, toId])
  @@index([toId, fromId])
}

model Client {
  id        String   @id @default(uuid())
  name      String
  // the name as it appears in the address (/clients/elle-sera); follows the
  // name when it's renamed — see lib/slug.ts
  slug      String   @unique
  // matches the Notion Clients Dashboard "Status" property: Current | On Hold | Previous
  status    String   @default("current")
  // free text — real clients span far more than doctors/podcasts (e.g. Neelkamal TMT is a steel company)
  niche     String?
  // the editors ops has given this client to; no one else in that role sees it
  editors   User[]   @relation("ClientEditors")
  // the four things the real Notion onboarding form collects, kept as
  // separate fields rather than one free-text blob so they're usable
  contact   String? // primary contact's name
  email     String?
  whatsapp  String?
  address   String?  @db.Text
  createdAt DateTime @default(now())

  // a small square image, stored as a data: URI directly in the row
  // (downscaled client-side before upload) — no object storage wired up
  // for this yet, and a client roster is small enough that this is fine.
  // Null falls back to the colored-initial avatar every other person/
  // client in this app already gets.
  avatarUrl String? @db.Text

  // The one template every client gets: the three pages every client's
  // Notion editor workbook already has (Client Information / Editing SOP /
  // Quality Checklist) plus a catch-all for links. Markdown, rendered by
  // <Markdown> — real documents native to this app, not links out to
  // Notion, which is being retired once this system replaces it.
  brandGuidelines  String? @db.Text
  sop              String? @db.Text
  qualityChecklist String? @db.Text
  meetingNotes     String? @db.Text
  resources        String? @db.Text
  // free-form relationship/context notes — how the account is going,
  // anything ops needs to remember about working with this client
  notes            String? @db.Text

  tags           Tag[]
  invites        ClientInvite[]
  documents      ClientDocument[]
  editorFeedback PerformanceEntry[]

  // set only for clients pulled in by the Notion clients sync — same
  // idempotency trick as Task.notionPageId
  notionPageId String? @unique

  // billing rule — Notion has no concept of this, so it's null until
  // someone sets it here. Exactly one of the two fields below applies,
  // depending on billingCadence.
  billingCadence        BillingCadence?
  billingDayOfMonth     Int? // monthly_date: which day of the month (1-31)
  billingMilestoneCount Int? // milestone: delivered tasks per invoice
  // anchor for "delivered since last invoice" on milestone clients —
  // reset every time a new invoice is logged for this client
  lastInvoicedAt        DateTime?

  // the client's own content database in Notion (one row per episode).
  // Set it here and the Import button can pull their projects and files in
  // — it used to mean running a script with the id hard-coded.
  notionContentDbId String?

  // where this client sits on the Clients dashboard — dragged into place,
  // shared by everyone, lower first. A float so moving one card between
  // two others is a single write (their midpoint).
  sortOrder Float @default(0)

  // Off until ops switches it on: the client's own read-only page at the
  // same address (/clients/<slug>) for anyone not signed in — see proxy.ts.
  shareEnabled Boolean @default(false)

  // Their folder on the company Drive, made when they onboard — anything
  // they upload on the onboarding form lands inside it (lib/drive.ts).
  driveFolderId  String?
  driveFolderUrl String?

  // Whose public numbers the Analytics tab shows: their YouTube channel (a
  // link, @handle or channel id) and Instagram @handle. Nothing is connected
  // per client — the app reads what anyone can see (lib/youtube.ts,
  // lib/instagram.ts).
  youtubeChannel  String?
  instagramHandle String?

  // The content blueprint: per deliverable type, how many one project makes
  // and on which days they're due (lib/contentPlan.ts). Null = the default.
  contentPlan Json?

  // where their audience already is: {youtube, instagram, website, podcast…},
  // as filled in on the onboarding form
  socialLinks Json?

  projects       Project[]
  feedback       ClientFeedback[]
  invoices       Invoice[]
  deliverables   Deliverable[]
  onboarding     OnboardingStep[]
  content        ContentItem[]
  socialAccounts SocialAccount[]
}

// One of a client's videos or posts, as last scraped from its public page
// (lib/contentSync.ts). Kept, so every analytics view opens straight from
// here — nothing waits on a scrape — and each daily scrape only has to
// refresh what's recent.
model ContentItem {
  id          String   @id @default(uuid())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  platform    String // youtube | instagram
  externalId  String // the video / post id on that platform
  title       String
  url         String
  thumbnail   String?  @db.Text
  kind        String // Video, Short, Reel, Post, Carousel
  publishedAt DateTime
  views       Int?
  likes       Int?
  comments    Int?
  // when these numbers were read — older posts are read less often
  scrapedAt   DateTime
  // Whether it's our work rather than something the client posted
  // themselves: true / false once decided, null while nobody has. Decided by
  // matching one of our tasks (oursBy "task") or by someone here ("person"),
  // who always has the last word.
  ours        Boolean?
  oursBy      String?
  matchedTask String?

  @@unique([platform, externalId])
  @@index([clientId, platform, publishedAt])
  @@index([publishedAt])
}

// A client's channel or account itself, as last scraped
model SocialAccount {
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  platform     String // youtube | instagram
  handle       String // the Instagram username / channel address it was read from
  name         String?
  image        String?   @db.Text
  followers    Int?
  totalViews   Int?
  totalPosts   Int?
  // how far back its posts have been read — a range before this needs a
  // one-off scrape of its own
  coveredSince DateTime?
  // everything on it is ours unless marked otherwise (a channel we run), as
  // opposed to only what's matched or marked (an account the client posts on
  // too)
  allOurs      Boolean   @default(false)
  scrapedAt    DateTime?

  @@id([clientId, platform])
}

// A scrape in flight on Apify. Collected when Apify calls back (or the next
// time anyone looks), then kept briefly as a record.
model ScrapeRun {
  id        String    @id // Apify's run id
  platform  String // youtube | instagram
  kind      String // posts | details | videos
  // which of the team's Apify tokens started it (a hash, not the token)
  account   String
  // the accounts it covers: address → client id
  targets   Json
  since     DateTime
  status    String    @default("RUNNING")
  startedAt DateTime  @default(now())
  checkedAt DateTime?
  doneAt    DateTime?
}

// The one shape every client gets, held as data so ops can change it
// without a deploy. Exactly one row (id "default") — Notion enforced this
// same structure by habit and a written SOP; here, creating a client
// applies it, so a client set up on a busy week isn't missing half of it.
model ClientTemplate {
  id String @id @default("default")

  // starter text for the four client documents, copied onto every new
  // client so nobody starts from a blank page
  brandGuidelines  String? @db.Text
  sop              String? @db.Text
  qualityChecklist String? @db.Text
  meetingNotes     String? @db.Text
  resources        String? @db.Text

  // [{ name, detail }] — the contracted scope a new client starts with
  deliverables Json   @default("[]")
  // [{ title, detail }] — the Client Onboarding SOP's steps, as a checklist
  onboarding   Json   @default("[]")
  // tag names applied to every new client (must already exist in Tag)
  tags         Json   @default("[]")
  // the project a client starts with, e.g. "Podcast"
  projectType  String @default("Podcast")

  updatedAt DateTime @updatedAt
}

// One step of the onboarding SOP, copied from the template when a client is
// created. Kept per-client (not a shared checklist) because each client
// works through it at their own pace and ops needs to see who's stuck.
model OnboardingStep {
  id        String  @id @default(uuid())
  client    Client  @relation(fields: [clientId], references: [id])
  clientId  String
  title     String
  detail    String? @db.Text
  done      Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([clientId])
}

// Freeform labels ops assigns to clients — "Podcast", "Personal brand",
// "Leadership", and also the two the team always uses to describe how a
// client is engaged: "Subscription" and "Project" (seeded once, fixed
// colors, so that specific distinction can't drift into two different
// spellings of the same tag). Anyone on ops can create a new one from the
// client page; the pool is shared across every client, not per-client.
model Tag {
  id      String   @id @default(uuid())
  name    String   @unique
  // a hex color, picked from a small fixed palette at creation time
  color   String
  clients Client[]
}

// What kind of work a task is — "Thumbnail", "Audio engineering",
// "YouTube management". Deliberately separate from Tag above, which labels
// *clients* and carries a colour: these label tasks, there are a lot of them
// on screen at once, and colouring them would turn every card into a
// rainbow competing with the status pill that actually needs to stand out.
//
// clientFacing says whether this kind of work produces something the client
// actually receives (a reel, a thumbnail, the final cut) as opposed to work
// done for them that never leaves the studio (audio engineering, colour
// correction, channel management). It's the default for a task tagged this
// way, not a hard rule — Task.internal is what each task actually goes by.
model TaskTag {
  id           String         @id @default(uuid())
  name         String         @unique
  clientFacing Boolean        @default(true)
  sortOrder    Int            @default(0)
  // Which side of the agency this kind of work belongs to. Sales shouldn't
  // have to pick past "Colour correction" and Operations shouldn't see
  // "Cold outreach". null means shared by everyone.
  team         Team?          @relation(fields: [teamId], references: [id])
  teamId       String?
  // the role that does this kind of work, and how its tasks move:
  // "video" (the editing stages), "design" (queued to final export, graded)
  // or "todo" (to do, done). See lib/workflows.ts
  role         JobTitle?      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  roleId       String?
  workflow     String         @default("video")
  tasks        Task[]
  workTasks    WorkTask[]
  assets       ProjectAsset[]
}

// The contracted scope, one line per deliverable — e.g. "Podcast episodes"
// / "2 long-form per cycle", "Thumbnails" / "custom, for all content".
// This is the client's overall retainer, distinct from Task: a client's
// individual Tasks are the day-to-day work items (a specific episode's
// edit, a specific thumbnail); a Deliverable is the recurring category
// they roll up into. Verified against the real "Deliverables:" section on
// several actual Notion client pages, not assumed.
model Deliverable {
  id             String   @id @default(uuid())
  client         Client   @relation(fields: [clientId], references: [id])
  clientId       String
  name           String // e.g. "Podcast episodes", "Thumbnails"
  detail         String? // e.g. "2 long-form per cycle (3 guest + 1 solo per batch)"
  // running total delivered to date — the real historical volume (e.g.
  // "14 podcast episodes so far") lives in Notion's task history, which
  // this app doesn't have a clean structured way to recompute per
  // deliverable type, so it's a plain number ops keeps up to date rather
  // than something auto-derived
  deliveredCount Int      @default(0)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

// One piece of work for a client — for a podcast client that's one episode
// ("Military Leaders"), the unit they're actually invoiced for. A client
// runs ~4 a month; each one gathers the Tasks the team works through and
// the ProjectAssets that come out the other end (the long-form cut, the
// reels, thumbnails, YT copy). Mirrors the per-episode pages in each
// client's own Notion database, covers included.
model Project {
  id            String         @id @default(uuid())
  client        Client         @relation(fields: [clientId], references: [id])
  clientId      String
  name          String         @default("")
  type          String
  engagement    EngagementType @default(subscription)
  status        String         @default("in_progress") // in_progress | completed
  // a downscaled copy of the Notion page cover, served from public/covers —
  // Notion's own file URLs are signed and expire within the hour, so they
  // can't be stored and re-served
  coverUrl      String?
  driveLink     String?
  invoiceStatus String? // paid | unpaid | null when not tracked
  // which invoice it's in when someone's moved it there by hand ("batch-3",
  // or "2026-09" for monthly billing); null = wherever the rule puts it
  invoiceBatch  String?
  completedAt   DateTime?
  notionPageId  String?        @unique
  createdAt     DateTime       @default(now())

  tasks          Task[]
  invoices       Invoice[]
  assets         ProjectAsset[]
  workTasks      WorkTask[]
  editorFeedback PerformanceEntry[]
}

model Task {
  id           String     @id @default(uuid())
  project      Project    @relation(fields: [projectId], references: [id])
  projectId    String
  assignedTo   User?      @relation("AssignedTasks", fields: [assignedToId], references: [id])
  assignedToId String?
  title        String
  status       TaskStatus @default(queued)
  // the day work on it starts — with dueDate, the span the content calendar
  // draws it across. Null = just its due day.
  startDate    DateTime?
  // when the assigned person has to finish it by — their deadline
  dueDate      DateTime?
  // when it goes to the client. Never set on internal work, which the
  // client doesn't receive.
  deliveryDate DateTime?
  // when it goes live on the client's channel: a reel's or video's posting
  // day, for the week calendar on the client's page. Client work only.
  postDate     DateTime?
  // null = visible immediately. Set = hidden from the assigned editor's
  // board/list until this date; ops/admin always see it regardless, so
  // work can be queued up ahead of time without cluttering an editor's
  // queue early. No cron needed — it's just a date compared on every load.
  scheduledFor DateTime?
  // manual drag-to-reorder position within a status column (lower sorts
  // first); a float so inserting between two cards is one write (new
  // midpoint value) instead of shifting every sibling's index
  sortOrder    Float      @default(0)

  // matches the Notion "Editing Queue" columns:
  rawLink       String? // raw footage handed to the editor (input)
  referenceLink String? // style/inspo reference for the edit
  assetLink     String? // supporting assets (b-roll, graphics, etc.)
  // free-form brief from ops when assigning/editing — instructions, context,
  // reference links, whatever the editor needs; distinct from reviewNotes
  // (which is specifically the "what needs to change" note on a revision)
  editingNotes  String?

  // review pipeline: editor submits a Frame.io link, admin QCs it,
  // approved work gets a Drive link once the team uploads it there (output)
  frameioLink   String?
  driveLink     String?
  reviewedBy    User?     @relation("ReviewedTasks", fields: [reviewedById], references: [id])
  reviewedById  String?
  reviewNotes   String?
  // how many times ops has sent this back for revision — incremented on
  // every transition into revision_requested, never reset; a quick signal
  // for "this one's eaten a lot of back-and-forth"
  revisionCount Int       @default(0)
  // The first time this task reached the client (or went past that point —
  // internal work skips straight to export). Set once and never moved: the
  // due date is the editor's deadline for exactly this, so a client
  // revision afterwards doesn't reopen it. See lib/due.ts.
  handedOffAt   DateTime?

  // The work this task is: thumbnail, audio engineering, reel, and so on.
  tags     TaskTag[]
  // Work done for this client that they never receive as a file — audio
  // engineering, colour correction, channel management. It still belongs to
  // the client, still gets assigned and tracked; it just isn't a deliverable,
  // so it stays out of the delivered counts and doesn't need the
  // Frame.io/client-approval round trip. Everything that existed before this
  // was a deliverable, which is why the default is false.
  internal Boolean   @default(false)

  // how it moves (lib/workflows.ts): "video", "design" or "todo", from its
  // kind of work when it's added
  workflow String  @default("video")
  // the department it belongs to: whose Leads see it (lib/scope.ts)
  team     Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId   String?

  // who added it (older tasks: unknown)
  createdById String?
  // times it has gone past its completion date (dueDate), and the date last
  // counted, so one miss is counted once (lib/overdue.ts)
  strikes     Int              @default(0)
  overdueFor  DateTime?
  shares      TaskShare[]
  dateChanges TaskDateChange[]

  // True when *this app* created the Notion page, rather than the row having
  // been pulled in from Notion. It decides which side wins on sync: a task
  // born here pushes its status and links up; a task born in Notion keeps
  // pulling down. One owner per row, so neither side silently overwrites the
  // other.
  notionCreatedByApp Boolean @default(false)

  // set only for tasks pulled in by the temporary Notion sync button —
  // stops a repeat click from re-creating the same task. Null for every
  // normal task. Drop this column when the Notion sync is removed.
  notionPageId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // last status change — the basis for editor history/turnaround KPIs

  feedback        Feedback[]
  performance     PerformanceEntry[]
  // left out of the editor's numbers: reassigned mid-way, a test, anything
  // ops decides shouldn't count for or against them
  kpiExcluded     Boolean            @default(false)
  // the quality inspection's grade on first review (S, A+, A, B, C, D),
  // when, and by whom (a user id)
  inspectionGrade String?
  inspectedAt     DateTime?
  inspectedById   String?
  // the video's Quality and overall scores out of 100 (lib/videoScore.ts),
  // kept here so any card or row can be tinted without working them out:
  // recomputed on every move, grade, feedback change and Frame.io sync
  qualityScore    Float?
  videoScore      Float?
  // "S" (a gold card) or "A+" (a green one) by Quality; null otherwise
  tier            String?
}

// A personal/team work item — see the WorkTaskStatus comment above for how
// this differs from Task. Everyone can create their own; only an admin can
// create or reassign one to somebody else (enforced in actions.ts, not
// here — same approach as Task's role rules living in workflow.ts).
model WorkTask {
  id        String         @id @default(uuid())
  title     String
  notes     String?        @db.Text
  status    WorkTaskStatus @default(todo)
  // free text, not a relation — "Audio", "Graphics", "Research"; a whole
  // tag-management system is overkill for what's just a label on a
  // personal to-do
  category  String?
  dueDate   DateTime?
  // manual drag-to-reorder within a status column — same float-midpoint
  // trick as Task.sortOrder
  sortOrder Float          @default(0)

  // the department it belongs to: whose Leads see it (lib/scope.ts)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId String?

  // times it has gone past its completion date (dueDate), as on Task
  strikes     Int              @default(0)
  overdueFor  DateTime?
  shares      TaskShare[]
  dateChanges TaskDateChange[]

  createdBy    User   @relation("WorkTasksCreated", fields: [createdById], references: [id])
  createdById  String
  assignedTo   User   @relation("WorkTasksAssigned", fields: [assignedToId], references: [id])
  assignedToId String

  // optional context — "this is the audio pass for that episode" —
  // without making it a formal step in that project's own task pipeline
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  // Same tags the client pipeline uses, so "what kind of work was this"
  // means one thing across the whole app rather than two parallel
  // vocabularies. Replaces the old free-text `category`.
  tags TaskTag[]

  // The row mirroring this task in Notion's Editing Queue, when it has one.
  // Work tasks only ever push up — they're born here, so there's no
  // pull-down direction to conflict with.
  notionPageId     String?
  // which Notion database that page is in (a workbook, or the Editing
  // Queue): when the task is handed to someone else, a page in the wrong
  // person's Notion is taken out rather than updated in place
  notionDatabaseId String?

  // Stamped when it first reaches `done`, and left alone afterwards — this
  // is what an employee's work history is built from, so it has to record
  // when the work was actually finished, not when the row was last touched.
  completedAt DateTime?

  // [{ label, url }] — reference links (Notion, Drive, Frame.io…), same
  // free-form shape as everywhere else in this app that needs a handful of
  // named links without a dedicated column per link
  links       Json @default("[]")
  // [{ name, dataUrl }] — small images/files attached directly, same
  // downscale-then-store-as-data-URI approach as client avatars/project
  // covers (see Client.avatarUrl); no object storage wired up for this app
  attachments Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([createdById])
}

model Feedback {
  id        String   @id @default(uuid())
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime @default(now())
}

// What a client sends from their shared page. Nobody signs in to send it,
// so it's only ever text, capped, and rate-limited per client.
model ClientFeedback {
  id        String    @id @default(uuid())
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  name      String?
  message   String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId, createdAt])
}

model KpiSnapshot {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  period    String // e.g. "2026-09" for monthly
  metrics   Json // { turnaroundHours, revisionCount, tasksCompleted, onTimePct }
  createdAt DateTime @default(now())

  @@unique([userId, period])
}

model Invoice {
  id        String        @id @default(uuid())
  client    Client        @relation(fields: [clientId], references: [id])
  clientId  String
  project   Project?      @relation(fields: [projectId], references: [id])
  projectId String?
  amount    Decimal
  status    InvoiceStatus @default(draft)
  pdfUrl    String?
  dueDate   DateTime?
  // set when it's marked paid; what Finance counts as collected, and when
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  // Ready for Skydo, which clients pay through: its invoice number, the
  // currency it was raised in, and where it lives there. "manual" until the
  // Skydo workflow is connected and starts filling these in itself.
  number      String?
  currency    String  @default("INR")
  source      String  @default("manual")
  externalId  String? @unique
  externalUrl String?
  notes       String? @db.Text
}

// What a person was paid for a month. The team is paid from the payroll
// spreadsheet, not through Skydo; until that sheet is connected, the admin
// marks a month paid here. One row per person per month ("2026-09").
model SalaryPayment {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  period    String
  // what was due that month, and what's been paid of it
  amount    Decimal   @db.Decimal(12, 2)
  paid      Decimal   @default(0) @db.Decimal(12, 2)
  paidAt    DateTime?
  note      String?
  // manual | sheet — the row of the payroll sheet it came from, once connected
  source    String    @default("manual")
  sheetRef  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, period])
}

// One piece of feedback on an editor's work. A mistake counts against their
// grade (the A+ to F scale from the Notion performance review); creative
// feedback is ordinary direction; praise and notes are for the record.
// Some arrive on their own (Frame.io review comments, sorted by Claude; the
// old Notion log), the rest ops writes in, and every one can be corrected.
model PerformanceEntry {
  id            String            @id @default(uuid())
  editor        User              @relation("PerformanceAbout", fields: [editorId], references: [id], onDelete: Cascade)
  editorId      String
  task          Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId        String?
  // what it's about, if anything in particular: a client, a project
  client        Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId      String?
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId     String?
  // mistake: a mistake in the work, counted against Quality by its type
  // positive | negative: praise or a concern, adding or taking its points
  //   off Feedback (always has points, except Frame.io praise, which is
  //   worth the scoring's "Frame.io praise" amount)
  // guidance: a tip (a creative suggestion, advice, anything else); never
  //   scored
  kind          String
  // a mistake's kind: Typos, Subtitles, Sound…
  category      String?
  body          String            @db.Text
  // how many times it happened (the Notion log counted a mistake per week)
  count         Int               @default(1)
  // for positive or negative feedback: how many points it adds or takes off
  points        Float?
  // where a Frame.io comment was left: the cut's file and the frame, for
  // its snapshot
  frameioFileId String?
  frame         Int?
  snapshot      FeedbackSnapshot?
  at            DateTime
  // manual | frameio | notion, and the id there, so a sync never repeats one
  source        String            @default("manual")
  sourceId      String?           @unique
  // who said it: the reviewer on Frame.io, or whoever wrote it here
  by            String?
  fromClient    Boolean           @default(false)
  // an automatic entry that someone has looked over or corrected
  reviewed      Boolean           @default(false)
  // dealt with: for a Frame.io comment, when the editor ticked it done
  // there (read back on every sync); for anything else, when core marked
  // it so. Null = still open.
  resolvedAt    DateTime?
  loggedBy      User?             @relation("PerformanceLogged", fields: [loggedById], references: [id])
  loggedById    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([editorId, at])
}

model ActivityLog {
  id        String   @id @default(uuid())
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
}

// A one-off link sent to a new client so they can fill in their own details
// (see /onboarding/<token>). No account, no password: the token is the
// permission, it works until it's used, and ops can see who has filled
// theirs in. Submitting one creates — or completes — the client's record.
model ClientInvite {
  id    String  @id @default(uuid())
  token String  @unique
  // what ops called them when the link was made, before the client says
  // what they'd rather be called
  name  String?

  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  // filled in: when, and which client record came out of it
  usedAt   DateTime?
  client   Client?   @relation(fields: [clientId], references: [id])
  clientId String?

  @@index([clientId])
}

// A document on a client's page beyond the five every client starts with
// (see ClientInfo's DOCS) — a channel strategy, a tone-of-voice note, a
// per-series brief. Markdown, same as the built-in ones.
model ClientDocument {
  id        String   @id @default(uuid())
  client    Client   @relation(fields: [clientId], references: [id])
  clientId  String
  title     String
  content   String?  @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([clientId])
}

// Small key/value store for things ops connects from inside the app — the
// Google Drive link being the first. Kept in the database rather than in
// deploy settings so connecting (or re-connecting) is something the team
// does for itself, without a developer.
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// A client's service agreement, from the first form they fill in to the
// signed copy (see lib/contract.ts). Ops makes a link; the client fills in
// who they are at /start/<token>; ops adds the terms, reviews the clauses and
// approves; then it goes out through Acrobat's e-signing, followed from
// Adobe's emails in Gmail.
model Contract {
  id          String    @id @default(uuid())
  // the client's form link — it stops working once they've sent it
  token       String    @unique
  // what ops called them when the link was made
  name        String?
  // invited → draft (the client sent the form) → approved → sent → signed.
  // Any edit to an approved one takes it back to draft.
  status      String    @default("invited")
  // the form exactly as the client sent it, kept apart from `details`,
  // which ops then corrects and adds to
  intake      Json?
  details     Json
  // this contract's own copy of the master template's clauses, edited freely
  clauses     Json
  // the conversation with Claude about it: [{ role, text, at }]
  chat        Json?
  // what Adobe's emails to easeus.media@gmail.com said about it — sent,
  // signed, filed — read from Gmail: [{ at, kind, text, id }]
  events      Json?
  // the signed copy, from Adobe's "Signed and Filed" email
  signedPdf   Bytes?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?
  approvedAt  DateTime?
  sentAt      DateTime?
  signedAt    DateTime?
}

// Every call to Claude, whatever asked for it (the admin's assistant, the
// Frame.io sorter, the contract assistant): its tokens and what it cost, so
// the month's spend is known before the next call is made and a call that
// would overrun the allowance isn't.
model AiUsage {
  id               String   @id @default(uuid())
  at               DateTime @default(now())
  // assistant | frameio | contracts
  feature          String
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Float
  userId           String?

  @@index([at])
}

// Something an editor is working on improving ("Sound design"), kept open
// week after week, for months if need be, until ops marks it improved. The
// A type of mistake in an editor's work, set up by core: Typos, UK/US
// spelling, Sound… Every Frame.io comment that's a mistake is sorted into
// one by its keywords (no AI), correctable by hand. weight: the Quality
// points one takes off (0.5; 0 recorded but not counted). keywords: words
// or phrases, comma-separated, that put a comment here. description: what
// it means, shown behind the (i) beside it.
model FeedbackCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  weight      Float    @default(1)
  // the video system's points off a video's Quality for one (lib/videoScore.ts);
  // weight above is the old scorecard's, kept until the new one ships
  points      Float    @default(2)
  // whether the same kind again, on another video, counts as a repeat
  // (a typo again, yes; another creative note, usually not)
  repeats     Boolean  @default(true)
  keywords    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

// A small picture of the frame a Frame.io comment was left on, so the
// editor can see exactly what was meant. Low resolution, and kept about
// four months (the nightly job clears older ones); the comment's text stays.
model FeedbackSnapshot {
  entry     PerformanceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId   String           @id
  image     Bytes
  createdAt DateTime         @default(now())
}

// Something a Level 1 wants in front of them on Home: a reminder, a
// deadline, anything worth a line. Shown until it's cleared.
model Notice {
  id         String    @id @default(uuid())
  body       String    @db.Text
  // who wrote it, by name (a note, not an access record)
  by         String?
  createdAt  DateTime  @default(now())
  // who it's for: a person (an overdue task, being added to one), or null
  // for Level 1's own notes
  forId      String?
  // note | overdue | shared | deleted
  kind       String    @default("note")
  // the task it's about, either kind
  taskId     String?
  workTaskId String?
  readAt     DateTime?

  @@index([forId])
}

// Someone brought onto a task by someone else, and why: they share it, it
// shows in their My tasks, and the reason tells them what it's about
model TaskShare {
  id         String    @id @default(uuid())
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String?
  workTask   WorkTask? @relation(fields: [workTaskId], references: [id], onDelete: Cascade)
  workTaskId String?
  userId     String
  byId       String
  reason     String    @db.Text
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// A completion date moved, and why. `strike` is how many times the task had
// gone past its date when it was moved (0: moved before it was due).
model TaskDateChange {
  id         String    @id @default(uuid())
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String?
  workTask   WorkTask? @relation(fields: [workTaskId], references: [id], onDelete: Cascade)
  workTaskId String?
  from       DateTime?
  to         DateTime?
  reason     String    @db.Text
  byId       String
  strike     Int       @default(0)
  createdAt  DateTime  @default(now())
}

// A task that was deleted: kept whole, with who deleted it and why, so the
// record survives (History shows it; Level 1 can bring it back)
model DeletedTask {
  id         String   @id @default(uuid())
  // "client" (Task) or "todo" (WorkTask), and its id while it lived
  kind       String
  originalId String
  title      String
  client     String?
  assignee   String?
  // the whole row as it was, to restore it
  data       Json
  reason     String   @db.Text
  byId       String
  byName     String
  createdAt  DateTime
  deletedAt  DateTime @default(now())
}
